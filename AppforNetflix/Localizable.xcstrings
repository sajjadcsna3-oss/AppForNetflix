        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটওয়ার্ক ত্রুটি। আপনার ইন্টারনেট সংযোগ পরীক্ষা করুন."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chyba sítě. Zkontrolujte připojení k internetu."
