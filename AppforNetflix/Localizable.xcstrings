    "Movies you open will show up here so you can find them again quickly.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر الأفلام التي تفتحها هنا حتى تتمكن من العثور عليها مرة أخرى بسرعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে চলচ্চিত্রগুলি খুলবেন সেগুলি এখানে প্রদর্শিত হবে যাতে আপনি সেগুলিকে আবার দ্রুত খুঁজে পেতে পারেন৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí filmy, které otevřete, abyste je mohli rychle znovu najít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Film, du åbner, vises her, så du hurtigt kan finde dem igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die von Ihnen geöffneten Filme werden hier angezeigt, sodass Sie sie schnell wiederfinden können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ταινίες που ανοίγετε θα εμφανίζονται εδώ, ώστε να μπορείτε να τις βρείτε ξανά γρήγορα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movies you open will show up here so you can find them again quickly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las películas que abras aparecerán aquí para que puedas volver a encontrarlas rápidamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaamasi elokuvat näkyvät täällä, jotta löydät ne nopeasti uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga pelikulang bubuksan mo para mahanap mo silang muli nang mabilis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les films que vous ouvrez s'afficheront ici afin que vous puissiez les retrouver rapidement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרטים שתפתח יופיעו כאן כדי שתוכל למצוא אותם שוב במהירות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके द्वारा खोली गई फिल्में यहां दिखाई देंगी ताकि आप उन्हें जल्दी से दोबारा ढूंढ सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmovi koje otvorite pojavit će se ovdje tako da ih možete brzo ponovno pronaći."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megnyitott filmek itt jelennek meg, így gyorsan újra megtalálhatja őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Film yang Anda buka akan muncul di sini sehingga Anda dapat menemukannya kembali dengan cepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I filmati aperti verranno visualizzati qui in modo da poterli ritrovare rapidamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いた映画はここに表示されるので、すぐに再度見つけることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열어본 영화가 여기에 표시되므로 빠르게 다시 찾을 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Filem yang anda buka akan dipaparkan di sini supaya anda boleh menemuinya semula dengan cepat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmer du åpner vises her slik at du raskt kan finne dem igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Films die u opent, worden hier weergegeven, zodat u ze snel kunt terugvinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj będą wyświetlane otwierane filmy, dzięki czemu będziesz mógł je szybko znaleźć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os filmes que abrir aparecerão aqui para que os possa encontrar novamente rapidamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmele pe care le deschideți vor apărea aici, astfel încât să le puteți găsi din nou rapid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытые вами фильмы будут отображаться здесь, и вы сможете быстро найти их снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazia filmy, ktoré otvoríte, aby ste ich mohli rýchlo znova nájsť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmer du öppnar visas här så att du snabbt kan hitta dem igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพยนตร์ที่คุณเปิดจะปรากฏขึ้นที่นี่ เพื่อให้คุณสามารถค้นหาได้อีกครั้งอย่างรวดเร็ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açtığınız filmler burada gösterilecek ve böylece onları hızlı bir şekilde tekrar bulabileceksiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фільми, які ви відкриваєте, відображатимуться тут, тож ви зможете швидко їх знову знайти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ جو فلمیں کھولیں گے وہ یہاں دکھائی دیں گی تاکہ آپ انہیں دوبارہ تلاش کر سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phim bạn mở sẽ hiển thị ở đây để bạn có thể tìm lại chúng một cách nhanh chóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您打开的电影将显示在此处，以便您可以快速再次找到它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您打開的電影將顯示在此處，以便您可以快速再次找到它們。"
          }
        }
      }
    },
