    "Titles will show up here once there's something to watch.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر العناوين هنا عندما يكون هناك شيء لمشاهدته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেখার মতো কিছু থাকলে শিরোনামগুলি এখানে প্রদর্শিত হবে৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tituly se zde zobrazí, jakmile bude na co se dívat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Titler vil dukke op her, når der er noget at se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Titel werden hier angezeigt, sobald es etwas zu sehen gibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τίτλοι θα εμφανίζονται εδώ μόλις υπάρχει κάτι να παρακολουθήσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles will show up here once there's something to watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos aparecerán aquí una vez que haya algo que ver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsikot näkyvät täällä, kun on jotain katsottavaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga pamagat kapag may mapapanood na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres apparaîtront ici une fois qu'il y aura quelque chose à regarder."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כותרות יופיעו כאן ברגע שיהיה מה לצפות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखने लायक कुछ होने पर शीर्षक यहां दिखाई देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslovi će se pojaviti ovdje kada bude bilo što za gledati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címek itt jelennek meg, ha lesz mit nézni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul akan muncul di sini setelah ada sesuatu untuk ditonton."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I titoli verranno visualizzati qui non appena ci sarà qualcosa da guardare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見たいものがあると、ここにタイトルが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청할 콘텐츠가 있으면 여기에 제목이 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajuk akan dipaparkan di sini apabila ada sesuatu untuk ditonton."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Titler vil dukke opp her når det er noe å se på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Titels verschijnen hier zodra er iets is om naar te kijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuły pojawią się tutaj, jeśli będzie coś do obejrzenia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os títulos aparecerão aqui assim que houver algo para assistir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlurile vor apărea aici odată ce aveți ceva de urmărit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовки появятся здесь, когда будет что посмотреть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tituly sa tu zobrazia, keď bude čo pozerať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlar kommer att dyka upp här när det finns något att titta på."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่องจะแสดงที่นี่เมื่อมีรายการให้ดู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlenecek bir şey olduğunda başlıklar burada gösterilecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назви з’являться тут, коли буде що подивитися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ دیکھنے کے بعد عنوانات یہاں نظر آئیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề sẽ hiển thị ở đây khi có nội dung nào đó để xem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦有值得观看的内容，标题就会显示在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦有值得觀看的內容，標題就會顯示在此。"
          }
        }
      }
    },
    "Titles you save will show up here so you can pick up right where you left off.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر العناوين التي تحفظها هنا حتى تتمكن من المتابعة من حيث توقفت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সেভ করা শিরোনামগুলি এখানে দেখাবে যাতে আপনি যেখান থেকে ছেড়েছিলেন সেখান থেকে শুরু করতে পারেন৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí uložené tituly, takže můžete pokračovat tam, kde jste skončili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Titler, du gemmer, vises her, så du kan fortsætte, hvor du slap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Ihnen gespeicherte Titel werden hier angezeigt, sodass Sie genau dort weitermachen können, wo Sie aufgehört haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τίτλοι που αποθηκεύετε θα εμφανίζονται εδώ, ώστε να μπορείτε να συνεχίσετε από εκεί που σταματήσατε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles you save will show up here so you can pick up right where you left off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos que guardes aparecerán aquí para que puedas retomarlos justo donde los dejaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentamasi nimikkeet näkyvät täällä, joten voit jatkaa siitä, mihin jäit."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga titulong ise-save mo para maulit mo kung saan ka tumigil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres que vous enregistrez apparaîtront ici afin que vous puissiez reprendre là où vous vous étiez arrêté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כותרים שתשמור יופיעו כאן כדי שתוכל להמשיך בדיוק מהנקודה שבה הפסקת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके द्वारा सहेजे गए शीर्षक यहां दिखाई देंगे ताकि आप वहीं से शुरू कर सकें जहां आपने छोड़ा था।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslovi koje ste spremili pojavit će se ovdje kako biste mogli nastaviti tamo gdje ste stali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett címek itt jelennek meg, így ott folytathatja, ahol abbahagyta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul yang Anda simpan akan muncul di sini sehingga Anda dapat melanjutkan dari bagian terakhir yang Anda tinggalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I titoli salvati verranno visualizzati qui in modo che tu possa riprendere da dove avevi interrotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したタイトルはここに表示されるので、中断したところから再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 제목이 여기에 표시되므로 중단한 부분부터 바로 시작할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajuk yang anda simpan akan dipaparkan di sini supaya anda boleh menyambung terus dari tempat anda berhenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Titler du lagrer vil dukke opp her, slik at du kan fortsette der du slapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Titels die u opslaat, worden hier weergegeven, zodat u verder kunt gaan waar u was gebleven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane tytuły pojawią się tutaj, dzięki czemu będziesz mógł kontynuować od miejsca, w którym przerwałeś."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os títulos que guardar aparecerão aqui para que possa continuar de onde parou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlurile pe care le salvați vor apărea aici, astfel încât să puteți continua chiar de unde ați rămas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраненные вами заголовки будут отображаться здесь, и вы сможете продолжить с того места, на котором остановились."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazia uložené tituly, takže môžete pokračovať tam, kde ste prestali."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlar du sparar kommer att dyka upp här så att du kan fortsätta precis där du slutade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหาที่คุณบันทึกจะปรากฏที่นี่ เพื่อให้คุณสามารถอ่านต่อจากจุดที่คุณค้างไว้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğiniz başlıklar burada görünecek, böylece kaldığınız yerden devam edebileceksiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережені назви відображатимуться тут, щоб ви могли продовжити там, де зупинилися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے محفوظ کردہ عنوانات یہاں نظر آئیں گے تاکہ آپ وہیں سے شروع کر سکیں جہاں سے آپ نے چھوڑا تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề bạn lưu sẽ hiển thị ở đây để bạn có thể tiếp tục ngay từ nơi bạn đã dừng lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您保存的标题将显示在此处，以便您可以从上次停下的地方继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您保存的標題將顯示在此處，以便您可以從上次停下的地方繼續。"
          }
        }
      }
    },
    "Too many failed attempts. Please try again later.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد كبير جدًا من المحاولات الفاشلة. يرجى المحاولة مرة أخرى في وقت لاحق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনেক ব্যর্থ প্রচেষ্টা. পরে আবার চেষ্টা করুন."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš mnoho neúspěšných pokusů. Zkuste to znovu později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange mislykkede forsøg. Prøv venligst igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele gescheiterte Versuche. Bitte versuchen Sie es später noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάρα πολλές αποτυχημένες προσπάθειες. Δοκιμάστε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many failed attempts. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos fallidos. Inténtelo de nuevo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian monta epäonnistunutta yritystä. Yritä myöhemmin uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Napakaraming nabigong pagtatangka. Pakisubukang muli mamaya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives infructueuses. Veuillez réessayer plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יותר מדי ניסיונות כושלים. אנא נסה שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत सारे असफल प्रयास. कृपया बाद में पुन: प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše neuspjelih pokušaja. Pokušajte ponovno kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok sikertelen próbálkozás. Kérjük, próbálja újra később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak upaya yang gagal. Silakan coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi falliti. Per favore riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗した試行が多すぎます。後でもう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패한 시도가 너무 많습니다. 나중에 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak percubaan yang gagal. Sila cuba lagi kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange mislykkede forsøk. Vennligst prøv igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel mislukte pogingen. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele nieudanych prób. Spróbuj ponownie później."
          }
        },
