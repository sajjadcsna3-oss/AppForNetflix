    "Streaming-provider availability data is provided by JustWatch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming-provider availability data is provided by JustWatch."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ট্রিমিং-প্রদানকারীর প্রাপ্যতা ডেটা JustWatch দ্বারা সরবরাহ করা হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje o dostupnosti poskytovatele streamování poskytuje JustWatch."
