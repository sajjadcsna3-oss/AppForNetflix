    "Server error. Make sure Email/Password Auth is enabled in your Firebase Console.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ في الخادم. تأكد من تمكين مصادقة البريد الإلكتروني/كلمة المرور في وحدة تحكم Firebase الخاصة بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্ভার ত্রুটি. নিশ্চিত করুন যে আপনার Firebase কনসোলে ইমেল/পাসওয়ার্ড প্রমাণ সক্ষম করা আছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chyba serveru. Ujistěte se, že je ve vaší Firebase Console povoleno ověření e-mailu/hesla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverfejl. Sørg for, at godkendelse af e-mail/adgangskode er aktiveret i din Firebase-konsol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverfehler. Stellen Sie sicher, dass die E-Mail-/Passwort-Authentifizierung in Ihrer Firebase-Konsole aktiviert ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σφάλμα διακομιστή. Βεβαιωθείτε ότι το Email/Password Auth είναι ενεργοποιημένο στο Firebase Console."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server error. Make sure Email/Password Auth is enabled in your Firebase Console."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error del servidor. Asegúrese de que la autenticación de correo electrónico/contraseña esté habilitada en su Firebase Console."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelinvirhe. Varmista, että sähköpostin/salasanan todennus on käytössä Firebase-konsolissa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Error sa server. Tiyaking naka-enable ang Email/Password Auth sa iyong Firebase Console."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur de serveur. Assurez-vous que l'authentification par e-mail/mot de passe est activée dans votre console Firebase."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שגיאת שרת. ודא שאימות דוא\"ל/סיסמה מופעל במסוף Firebase שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर त्रुटि. सुनिश्चित करें कि आपके फायरबेस कंसोल में ईमेल/पासवर्ड प्रमाणीकरण सक्षम है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Greška poslužitelja. Provjerite je li autentifikacija e-pošte/lozinke omogućena na vašoj Firebase konzoli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerver hiba. Győződjön meg arról, hogy az e-mail/jelszó hitelesítés engedélyezve van a Firebase-konzolon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesalahan server. Pastikan Auth Email/Kata Sandi diaktifkan di Firebase Console Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore del server. Assicurati che l'autenticazione email/password sia abilitata nella console Firebase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーエラー。 Firebase コンソールでメール/パスワード認証が有効になっていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 오류입니다. Firebase 콘솔에서 이메일/비밀번호 인증이 활성화되어 있는지 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ralat pelayan. Pastikan Pengesahan E-mel/Kata Laluan didayakan dalam Firebase Console anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverfeil. Sørg for at e-post-/passordautentisering er aktivert i Firebase-konsollen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverfout. Zorg ervoor dat e-mail-/wachtwoordverificatie is ingeschakeld in uw Firebase-console."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Błąd serwera. Upewnij się, że w konsoli Firebase włączona jest opcja uwierzytelniania za pomocą adresu e-mail/hasła."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro no servidor. Certifique-se de que a autenticação de e-mail/palavra-passe está ativada na sua Firebase Console."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eroare de server. Asigurați-vă că autentificarea e-mailului/parolă este activată în Consola Firebase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка сервера. Убедитесь, что в вашей консоли Firebase включена аутентификация по электронной почте/паролю."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chyba servera. Uistite sa, že je vo vašej konzole Firebase povolená e-mailová/heslová autorizácia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverfel. Se till att e-post-/lösenordsautentisering är aktiverat i din Firebase-konsol."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อผิดพลาดของเซิร์ฟเวอร์ ตรวจสอบให้แน่ใจว่าเปิดใช้งานการตรวจสอบสิทธิ์อีเมล/รหัสผ่านในคอนโซล Firebase ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu hatası. Firebase Konsolunuzda E-posta/Şifre Kimlik Doğrulamasının etkinleştirildiğinden emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помилка сервера. Переконайтеся, що у вашій консолі Firebase увімкнено автентифікацію електронної пошти/пароля."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور کی خرابی۔ یقینی بنائیں کہ آپ کے Firebase کنسول میں ای میل/پاس ورڈ کی تصدیق فعال ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi máy chủ. Đảm bảo Xác thực email/mật khẩu được bật trong Bảng điều khiển Firebase của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器错误。确保在 Firebase 控制台中启用电子邮件/密码身份验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器錯誤。確保在 Firebase 控制台中啟用電子郵件/密碼驗證。"
          }
        }
      }
    },
