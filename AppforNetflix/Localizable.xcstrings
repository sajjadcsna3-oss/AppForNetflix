    "Subscriptions will be available in a future update. Thanks for your patience!": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاشتراكات ستكون متاحة في التحديث المستقبلي. شكرا لصبرك!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাবস্ক্রিপশন ভবিষ্যতের আপডেটে পাওয়া যাবে। আপনার ধৈর্যের জন্য ধন্যবাদ!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné bude k dispozici v budoucí aktualizaci. Děkujeme za trpělivost!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer vil være tilgængelige i en fremtidig opdatering. Tak for din tålmodighed!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnements werden in einem zukünftigen Update verfügbar sein. Vielen Dank für Ihre Geduld!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συνδρομές θα είναι διαθέσιμες σε μελλοντική ενημέρωση. Ευχαριστώ για την υπομονή σας!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions will be available in a future update. Thanks for your patience!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones estarán disponibles en una actualización futura. ¡Gracias por tu paciencia!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaukset ovat saatavilla tulevassa päivityksessä. Kiitos kärsivällisyydestäsi!"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magiging available ang mga subscription sa isang update sa hinaharap. Salamat sa iyong pasensya!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements seront disponibles dans une prochaine mise à jour. Merci pour votre patience !"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מינויים יהיו זמינים בעדכון עתידי. תודה על הסבלנות שלך!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यताएँ भविष्य के अपडेट में उपलब्ध होंगी। आपके धैर्य के लिए धन्यवाद!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretplate će biti dostupne u budućem ažuriranju. Hvala na strpljenju!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előfizetések egy későbbi frissítésben lesznek elérhetők. Köszönjük türelmét!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan akan tersedia di pembaruan mendatang. Terima kasih atas kesabaran Anda!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli abbonamenti saranno disponibili in un aggiornamento futuro. Grazie per la pazienza!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは将来のアップデートで利用可能になる予定です。ご辛抱いただきありがとうございます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 향후 업데이트에서 제공될 예정입니다. 기다려주셔서 감사합니다!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan akan tersedia dalam kemas kini akan datang. Terima kasih atas kesabaran anda!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer vil være tilgjengelige i en fremtidig oppdatering. Takk for tålmodigheten!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementen zullen beschikbaar zijn in een toekomstige update. Bedankt voor uw geduld!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcje będą dostępne w przyszłej aktualizacji. Dziękujemy za cierpliwość!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As subscrições estarão disponíveis numa atualização futura. Obrigado pela sua paciência!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonamentele vor fi disponibile într-o actualizare viitoare. Vă mulțumim pentru răbdare!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки будут доступны в будущем обновлении. Спасибо за ваше терпение!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predplatné bude k dispozícii v budúcej aktualizácii. Ďakujeme za trpezlivosť!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerationer kommer att finnas tillgängliga i en framtida uppdatering. Tack för ditt tålamod!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกจะพร้อมใช้งานในการอัปเดตในอนาคต ขอบคุณสำหรับความอดทนของคุณ!"
          }
        },
        "tr": {
          "stringUnit": {
