    "For your security, please sign out and sign in again before deleting your account.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من أجل أمانك، يرجى تسجيل الخروج وتسجيل الدخول مرة أخرى قبل حذف حسابك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নিরাপত্তার জন্য, অনুগ্রহ করে সাইন আউট করুন এবং আপনার অ্যাকাউন্ট মুছে ফেলার আগে আবার সাইন ইন করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z bezpečnostních důvodů se před smazáním účtu odhlaste a znovu přihlaste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For din sikkerhed skal du logge ud og logge på igen, før du sletter din konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte melden Sie sich zu Ihrer Sicherheit ab und erneut an, bevor Sie Ihr Konto löschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για την ασφάλειά σας, αποσυνδεθείτε και συνδεθείτε ξανά πριν διαγράψετε τον λογαριασμό σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your security, please sign out and sign in again before deleting your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por su seguridad, cierre sesión y vuelva a iniciar sesión antes de eliminar su cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Turvallisuutesi vuoksi kirjaudu ulos ja kirjaudu sisään uudelleen ennen tilisi poistamista."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa iyong seguridad, mangyaring mag-sign out at mag-sign in muli bago tanggalin ang iyong account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour votre sécurité, veuillez vous déconnecter et vous reconnecter avant de supprimer votre compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למען אבטחתך, צא והיכנס שוב לפני מחיקת חשבונך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सुरक्षा के लिए, कृपया अपना खाता हटाने से पहले साइन आउट करें और दोबारा साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radi vaše sigurnosti odjavite se i ponovno prijavite prije brisanja računa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztonsága érdekében kérjük, jelentkezzen ki, majd jelentkezzen be újra, mielőtt törölné fiókját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Demi keamanan Anda, harap keluar dan masuk lagi sebelum menghapus akun Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la tua sicurezza, esci e accedi nuovamente prima di eliminare il tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティのため、アカウントを削除する前にサインアウトしてから再度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안을 위해 계정을 삭제하기 전에 로그아웃했다가 다시 로그인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk keselamatan anda, sila log keluar dan log masuk semula sebelum memadamkan akaun anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Av sikkerhetshensyn må du logge av og på igjen før du sletter kontoen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor uw veiligheid verzoeken wij u uit te loggen en opnieuw in te loggen voordat u uw account verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla własnego bezpieczeństwa wyloguj się i zaloguj ponownie przed usunięciem konta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sua segurança, saia e volte a iniciar sessão antes de eliminar a sua conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru securitatea dvs., vă rugăm să vă deconectați și să vă conectați din nou înainte de a vă șterge contul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В целях вашей безопасности выйдите из системы и войдите снова, прежде чем удалять свою учетную запись."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Z bezpečnostných dôvodov sa pred odstránením účtu odhláste a znova prihláste."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För din säkerhet, vänligen logga ut och logga in igen innan du tar bort ditt konto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อความปลอดภัยของคุณ โปรดออกจากระบบและลงชื่อเข้าใช้อีกครั้งก่อนที่จะลบบัญชีของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenliğiniz için lütfen hesabınızı silmeden önce oturumu kapatıp tekrar oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З міркувань безпеки вийдіть і ввійдіть знову, перш ніж видаляти обліковий запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی سیکیورٹی کے لیے، براہ کرم اپنا اکاؤنٹ حذف کرنے سے پہلے سائن آؤٹ کریں اور دوبارہ سائن ان کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để bảo mật, vui lòng đăng xuất và đăng nhập lại trước khi xóa tài khoản của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了您的安全，请先退出并重新登录，然后再删除您的帐户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了您的安全，請先退出並重新登錄，然後再刪除您的帳戶。"
          }
        }
      }
    },
