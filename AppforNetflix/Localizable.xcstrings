    "Search across all platforms—movies, shows, and documentaries.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عبر جميع المنصات — الأفلام والعروض والأفلام الوثائقية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্ত প্ল্যাটফর্মে অনুসন্ধান করুন—চলচ্চিত্র, শো এবং ডকুমেন্টারি৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledávejte na všech platformách – ve filmech, pořadech a dokumentech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søg på tværs af alle platforme – film, shows og dokumentarer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen Sie auf allen Plattformen – Filmen, Shows und Dokumentationen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζήτηση σε όλες τις πλατφόρμες—ταινίες, εκπομπές και ντοκιμαντέρ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search across all platforms—movies, shows, and documentaries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque en todas las plataformas: películas, programas y documentales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hae kaikilta alustoilta – elokuvista, ohjelmista ja dokumenteista."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maghanap sa lahat ng platform—mga pelikula, palabas, at dokumentaryo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez sur toutes les plateformes : films, émissions et documentaires."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חפש בכל הפלטפורמות - סרטים, תוכניות וסרטים תיעודיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी प्लेटफ़ॉर्म पर खोजें—फ़िल्में, शो और वृत्तचित्र।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretražujte na svim platformama—filmove, emisije i dokumentarne filmove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keresés minden platformon – filmek, műsorok és dokumentumfilmek között."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Telusuri di semua platform—film, acara TV, dan dokumenter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca su tutte le piattaforme: film, programmi e documentari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映画、番組、ドキュメンタリーなど、あらゆるプラットフォームを検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영화, 쇼, 다큐멘터리 등 모든 플랫폼에서 검색하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari merentas semua platform—filem, rancangan dan dokumentari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk på alle plattformer – filmer, serier og dokumentarer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek op alle platforms: films, shows en documentaires."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeszukuj wszystkie platformy — filmy, programy i filmy dokumentalne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise em todas as plataformas: filmes, programas e documentários."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Căutați pe toate platformele: filme, emisiuni și documentare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите по всем платформам — фильмам, шоу и документальным фильмам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhľadávajte na všetkých platformách – vo filmoch, reláciách a dokumentoch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök på alla plattformar – filmer, program och dokumentärer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาในทุกแพลตฟอร์ม ทั้งภาพยนตร์ รายการ และสารคดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmler, şovlar ve belgeseller dahil tüm platformlarda arama yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукайте на всіх платформах — у фільмах, шоу та документальних фільмах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام پلیٹ فارمز — موویز، شوز اور دستاویزی فلموں میں تلاش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm trên tất cả các nền tảng—phim, chương trình và phim tài liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跨所有平台搜索 - 电影、节目和纪录片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跨所有平台搜尋 - 電影、節目和紀錄片。"
          }
        }
      }
    },
