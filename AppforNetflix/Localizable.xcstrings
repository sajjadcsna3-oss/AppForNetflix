          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke laste inn kjøp. Vennligst prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan aankopen niet laden. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wczytać zakupów. Spróbuj ponownie."
          }
        },
        "pt-PT": {
