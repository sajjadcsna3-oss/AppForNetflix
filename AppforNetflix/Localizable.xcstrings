    "Subscribe for a better\nviewing experience.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترك من أجل الأفضل\nتجربة المشاهدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ভাল জন্য সদস্যতা\nদেখার অভিজ্ঞতা।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se k odběru pro lepší\ndivácký zážitek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonner for en bedre\nseeroplevelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnieren Sie für eine bessere\nSeherlebnis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγγραφείτε για καλύτερο\nεμπειρία θέασης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe for a better\nviewing experience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete para una mejor\nexperiencia de visualización."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaa saadaksesi paremman\nkatselukokemus."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-subscribe para sa isang mas mahusay\nkaranasan sa panonood."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnez-vous pour un meilleur\nexpérience visuelle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הירשם לטוב יותר\nחווית צפייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेहतरी के लिए सदस्यता लें\nदेखने का अनुभव."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretplatite se za bolje\niskustvo gledanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iratkozz fel a jobbért\nmegtekintési élmény."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlangganan untuk menjadi lebih baik\npengalaman menonton."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iscriviti per una migliore\nesperienza visiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購読してさらにお得に\n視聴体験。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 나은 것을 위해 구독하세요\n시청 경험."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Langgan untuk yang lebih baik\npengalaman menonton."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonner for en bedre\nseeropplevelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonneer je voor een beter\nkijkervaring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz się na lepsze\nwrażenia z oglądania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inscreva-se para um melhor\nexperiência de visualização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonați-vă pentru o mai bună\nexperiență de vizionare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпишитесь, чтобы стать лучше\nопыт просмотра."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihláste sa na odber lepšie\ndivácky zážitok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerera för en bättre\ntittarupplevelse."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมัครสมาชิกเพื่อสิ่งที่ดีกว่า\nประสบการณ์การรับชม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha iyisi için abone olun\ngörüntüleme deneyimi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підпишіться на краще\nдосвід перегляду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بہتر کے لیے سبسکرائب کریں۔\nدیکھنے کا تجربہ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký để tốt hơn\ntrải nghiệm xem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅以获得更好的\n观看体验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱以獲得更好的\n觀看體驗。"
          }
        }
      }
    },
