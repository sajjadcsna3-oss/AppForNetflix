    "Unable to load purchases. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to load purchases. Please try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير قادر على تحميل المشتريات. يرجى المحاولة مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেনাকাটা লোড করতে অক্ষম৷ আবার চেষ্টা করুন."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákupy nelze načíst. Zkuste to prosím znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einkäufe können nicht geladen werden. Bitte versuchen Sie es erneut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke indlæse køb. Prøv venligst igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατή η φόρτωση αγορών. Δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden cargar compras. Por favor inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoksia ei voi ladata. Yritä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-load ang mga binili. Pakisubukang muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les achats. Veuillez réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לטעון רכישות. אנא נסה שוב."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće učitati kupnje. Molimo pokušajte ponovo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदारी लोड करने में असमर्थ. कृपया पुन: प्रयास करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült betölteni a vásárlásokat. Kérjük, próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuat pembelian. Silakan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare gli acquisti. Per favore riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入したものを読み込めません。もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 항목을 로드할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
