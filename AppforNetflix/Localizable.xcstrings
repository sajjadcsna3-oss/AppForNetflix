    "This permanently deletes your account and associated account data. This action cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى حذف حسابك وبيانات الحساب المرتبطة به نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি স্থায়ীভাবে আপনার অ্যাকাউন্ট এবং সংশ্লিষ্ট অ্যাকাউন্ট ডেটা মুছে দেয়। এই ক্রিয়াটি পূর্বাবস্থায় ফেরানো যাবে না৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím trvale smažete svůj účet a související data účtu. Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter permanent din konto og tilhørende kontodata. Denne handling kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Ihr Konto und die damit verbundenen Kontodaten dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό διαγράφει οριστικά τον λογαριασμό σας και τα σχετικά δεδομένα λογαριασμού. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your account and associated account data. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente su cuenta y los datos de la cuenta asociados. Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pysyvästi tilisi ja siihen liittyvät tilitiedot. Tätä toimintoa ei voi kumota."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanente nitong tinatanggal ang iyong account at nauugnay na data ng account. Ang pagkilos na ito ay hindi maaaring i-undo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement votre compte et les données de compte associées. Cette action ne peut pas être annulée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוחקת לצמיתות את חשבונך ואת נתוני החשבון המשויכים. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके खाते और संबंधित खाता डेटा को स्थायी रूप से हटा देता है। इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo trajno briše vaš račun i povezane podatke računa. Ova se radnja ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel véglegesen törli a fiókját és a kapcsolódó fiókadatokat. Ez a művelet nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini akan menghapus akun Anda dan data akun terkait secara permanen. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò eliminerà permanentemente il tuo account e i dati dell'account associato. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、アカウントと関連するアカウント データが完全に削除されます。この操作は元に戻すことができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 귀하의 계정 및 관련 계정 데이터가 영구적으로 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memadamkan akaun anda dan data akaun yang berkaitan secara kekal. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter kontoen din og tilhørende kontodata permanent. Denne handlingen kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdoor worden uw account en de bijbehorende accountgegevens permanent verwijderd. Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie Twojego konta i powiązanych z nim danych. Tej akcji nie można cofnąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina permanentemente a sua conta e os dados associados à conta. Esta ação não pode ser anulada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest lucru vă șterge definitiv contul și datele asociate contului. Această acțiune nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При этом ваша учетная запись и связанные с ней данные будут удалены без возможности восстановления. Это действие невозможно отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto sa natrvalo odstráni váš účet a súvisiace údaje účtu. Túto akciu nie je možné vrátiť späť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta raderar ditt konto och tillhörande kontodata permanent. Denna åtgärd kan inte ångras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบบัญชีของคุณและข้อมูลบัญชีที่เกี่ยวข้องอย่างถาวร การดำเนินการนี้ไม่สามารถยกเลิกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, hesabınızı ve ilişkili hesap verilerinizi kalıcı olarak siler. Bu eylem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить ваш обліковий запис і пов’язані з ним дані. Цю дію не можна скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے آپ کا اکاؤنٹ اور اس سے وابستہ اکاؤنٹ کا ڈیٹا مستقل طور پر حذف ہو جاتا ہے۔ اس کارروائی کو کالعدم نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này sẽ xóa vĩnh viễn tài khoản của bạn và dữ liệu tài khoản được liên kết. Không thể hoàn tác hành động này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除您的帐户和关联的帐户数据。此操作无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除您的帳戶和關聯的帳戶資料。此操作無法撤銷。"
          }
        }
      }
    },
