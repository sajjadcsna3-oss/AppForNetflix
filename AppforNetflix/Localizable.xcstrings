        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте свою нову електронну адресу, щоб підтвердити зміну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدیلی کی تصدیق کے لیے اپنا نیا ای میل پتہ چیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
