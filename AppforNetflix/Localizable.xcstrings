    "Sign in to sync your profile and premium status": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتسجيل الدخول لمزامنة ملفك الشخصي وحالتك المميزة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রোফাইল এবং প্রিমিয়াম স্থিতি সিঙ্ক করতে সাইন ইন করুন৷"
          }
        },
        "cs": {
