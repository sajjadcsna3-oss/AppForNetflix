    "You haven't connected any streaming platforms yet — showing titles from everywhere. Connect platforms in Settings to personalize this.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تقم بتوصيل أي منصات بث حتى الآن — تظهر العناوين من كل مكان. قم بتوصيل الأنظمة الأساسية في الإعدادات لتخصيص ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এখনও কোনো স্ট্রিমিং প্ল্যাটফর্ম সংযুক্ত করেননি — সব জায়গা থেকে শিরোনাম দেখাচ্ছে। এটিকে ব্যক্তিগতকৃত করতে সেটিংসে প্ল্যাটফর্মগুলি সংযুক্ত করুন৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím jste nepřipojili žádné streamovací platformy – zobrazujete tituly odkudkoli. Chcete-li si to přizpůsobit, připojte platformy v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke tilsluttet nogen streamingplatforme endnu - viser titler overalt. Tilslut platforme i Indstillinger for at tilpasse dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben noch keine Streaming-Plattformen verbunden – Titel von überall werden angezeigt. Verbinden Sie Plattformen in den Einstellungen, um dies zu personalisieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχετε συνδέσει ακόμη πλατφόρμες ροής — εμφανίζοντας τίτλους από παντού. Συνδέστε τις πλατφόρμες στις Ρυθμίσεις για να το εξατομικεύσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't connected any streaming platforms yet — showing titles from everywhere. Connect platforms in Settings to personalize this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has conectado ninguna plataforma de streaming, mostrando títulos de todas partes. Conecte plataformas en Configuración para personalizar esto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole vielä yhdistänyt yhtään suoratoistoalustaa – näytät nimikkeitä kaikkialta. Yhdistä alustat asetuksissa muokataksesi tätä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ka pa nakakakonekta ng anumang streaming platform — nagpapakita ng mga pamagat mula sa lahat ng dako. Ikonekta ang mga platform sa Mga Setting para i-personalize ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez encore connecté aucune plateforme de streaming, affichant des titres de partout. Connectez les plateformes dans Paramètres pour personnaliser cela."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא חיברת אף פלטפורמת סטרימינג - מציג כותרים מכל מקום. חבר פלטפורמות בהגדרות כדי להתאים את זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अभी तक किसी भी स्ट्रीमिंग प्लेटफ़ॉर्म को कनेक्ट नहीं किया है - हर जगह से शीर्षक दिखा रहा है। इसे वैयक्तिकृत करने के लिए सेटिंग्स में प्लेटफ़ॉर्म कनेक्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još niste povezali nijednu platformu za strujanje — prikazuju se naslovi sa svih strana. Povežite platforme u Postavkama da ovo personalizirate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem csatlakozott egyetlen streamelési platformhoz sem – mindenhonnan címek jelennek meg. Csatlakoztassa a platformokat a Beállításokban a személyre szabáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum menghubungkan platform streaming apa pun — menampilkan judul dari mana saja. Hubungkan platform di Pengaturan untuk mempersonalisasi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora collegato nessuna piattaforma di streaming: mostri titoli da tutto il mondo. Connetti le piattaforme in Impostazioni per personalizzarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだストリーミング プラットフォームに接続していません。どこからでもタイトルを表示しています。これをパーソナライズするには、[設定] でプラットフォームを接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 스트리밍 플랫폼을 연결하지 않았습니다. 모든 곳의 타이틀을 표시합니다. 이를 개인화하려면 설정에서 플랫폼을 연결하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum menyambungkan mana-mana platform penstriman lagi — memaparkan tajuk dari mana-mana sahaja. Sambungkan platform dalam Tetapan untuk memperibadikan ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke koblet til noen strømmeplattformer ennå – viser titler fra overalt. Koble til plattformer i Innstillinger for å tilpasse dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nog geen streamingplatforms aangesloten, zodat je titels van overal kunt zien. Verbind platforms in Instellingen om dit te personaliseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie połączyłeś jeszcze żadnych platform do przesyłania strumieniowego — wyświetlanie tytułów zewsząd. Połącz platformy w Ustawieniach, aby je spersonalizować."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não ligou nenhuma plataforma de streaming – exibindo títulos de todo o lado. Ligue as plataformas em Configurações para personalizar isso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ați conectat încă nicio platformă de streaming - afișând titluri de peste tot. Conectați platformele în Setări pentru a personaliza acest lucru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы еще не подключили ни одну потоковую платформу — титры отображаются отовсюду. Подключите платформы в настройках, чтобы персонализировать это."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ ste nepripojili žiadne streamovacie platformy – zobrazujete tituly odkiaľkoľvek. Pripojte platformy v Nastaveniach a prispôsobte si to."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har inte anslutit några streamingplattformar än – visar titlar från överallt. Anslut plattformar i Inställningar för att anpassa detta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่ได้เชื่อมต่อกับแพลตฟอร์มสตรีมมิ่งใดๆ — กำลังแสดงเนื้อหาจากทุกที่ เชื่อมต่อแพลตฟอร์มในการตั้งค่าเพื่อปรับแต่งสิ่งนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz herhangi bir yayın platformunu bağlamadınız; her yerden içerik gösteriliyor. Bunu kişiselleştirmek için Ayarlar'daki platformları bağlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ще не підключили жодну платформу потокового передавання — відображаються заголовки звідусіль. Підключіть платформи в налаштуваннях, щоб персоналізувати це."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے ابھی تک کوئی بھی اسٹریمنگ پلیٹ فارم منسلک نہیں کیا ہے — ہر جگہ سے عنوان دکھا رہا ہے۔ اسے ذاتی نوعیت کا بنانے کے لیے ترتیبات میں پلیٹ فارمز کو مربوط کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa kết nối bất kỳ nền tảng phát trực tuyến nào — hiển thị video từ mọi nơi. Kết nối các nền tảng trong Cài đặt để cá nhân hóa điều này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您尚未连接任何流媒体平台 - 显示来自世界各地的影片。在“设置”中连接平台以对其进行个性化设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您尚未連接任何串流媒體平台 - 顯示來自世界各地的影片。在「設定」中連接平台以進行個人化設定。"
          }
        }
      }
    },
