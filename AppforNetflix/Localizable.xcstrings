    "No titles found on your connected platforms for this filter. Try connecting more platforms in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على عناوين على منصاتك المتصلة لهذا الفلتر. حاول توصيل المزيد من الأنظمة الأساسية في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফিল্টারের জন্য আপনার সংযুক্ত প্ল্যাটফর্মে কোনো শিরোনাম পাওয়া যায়নি। সেটিংসে আরও প্ল্যাটফর্ম সংযোগ করার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento filtr nebyly na vašich připojených platformách nalezeny žádné tituly. Zkuste v Nastavení připojit více platforem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet nogen titler på dine tilsluttede platforme til dette filter. Prøv at forbinde flere platforme i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Filter wurden auf Ihren verbundenen Plattformen keine Titel gefunden. Versuchen Sie, in den Einstellungen weitere Plattformen zu verbinden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν τίτλοι στις συνδεδεμένες πλατφόρμες σας για αυτό το φίλτρο. Δοκιμάστε να συνδέσετε περισσότερες πλατφόρμες στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No titles found on your connected platforms for this filter. Try connecting more platforms in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron títulos en sus plataformas conectadas para este filtro. Intente conectar más plataformas en Configuración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistetyiltä alustoiltasi ei löytynyt nimikkeitä tälle suodattimelle. Yritä yhdistää useampia alustoja asetuksissa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nakitang mga pamagat sa iyong mga konektadong platform para sa filter na ito. Subukang magkonekta ng higit pang mga platform sa Mga Setting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun titre trouvé sur vos plateformes connectées pour ce filtre. Essayez de connecter plus de plates-formes dans Paramètres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצאו כותרות בפלטפורמות המחוברות שלך עבור מסנן זה. נסה לחבר פלטפורמות נוספות בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़िल्टर के लिए आपके कनेक्टेड प्लेटफ़ॉर्म पर कोई शीर्षक नहीं मिला। सेटिंग्स में अधिक प्लेटफ़ॉर्म कनेक्ट करने का प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije pronađen nijedan naslov na vašim povezanim platformama za ovaj filtar. Pokušajte povezati više platformi u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez a szűrőhöz nem található cím a csatlakoztatott platformokon. Próbáljon meg több platformot csatlakoztatni a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada judul yang ditemukan di platform Anda yang terhubung untuk filter ini. Coba sambungkan lebih banyak platform di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun titolo trovato sulle piattaforme connesse per questo filtro. Prova a connettere più piattaforme in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続されているプラットフォーム上でこのフィルターに対応するタイトルが見つかりません。設定でさらに多くのプラットフォームに接続してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 플랫폼에서 이 필터에 해당하는 제목을 찾을 수 없습니다. 설정에서 더 많은 플랫폼을 연결해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada tajuk ditemui pada platform bersambung anda untuk penapis ini. Cuba sambungkan lebih banyak platform dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen titler funnet på de tilkoblede plattformene for dette filteret. Prøv å koble til flere plattformer i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen titels gevonden op uw verbonden platforms voor dit filter. Probeer meer platforms te verbinden via Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na połączonych platformach nie znaleziono tytułów dla tego filtra. Spróbuj połączyć więcej platform w Ustawieniach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum título encontrado nas suas plataformas conectadas para este filtro. Tente ligar mais plataformas em Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-au găsit titluri pe platformele dvs. conectate pentru acest filtru. Încercați să conectați mai multe platforme în Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого фильтра на подключенных платформах не найдено ни одного названия. Попробуйте подключить больше платформ в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre tento filter sa na vašich pripojených platformách nenašli žiadne tituly. Skúste v Nastaveniach pripojiť viac platforiem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga titlar hittades på dina anslutna plattformar för detta filter. Testa att ansluta fler plattformar i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบชื่อเรื่องบนแพลตฟอร์มที่เชื่อมต่อของคุณสำหรับตัวกรองนี้ ลองเชื่อมต่อแพลตฟอร์มเพิ่มเติมในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı platformlarınızda bu filtre için başlık bulunamadı. Ayarlar'da daha fazla platform bağlamayı deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На підключених платформах не знайдено назв для цього фільтра. Спробуйте підключити більше платформ у налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فلٹر کے لیے آپ کے منسلک پلیٹ فارمز پر کوئی عنوان نہیں ملے۔ ترتیبات میں مزید پلیٹ فارمز کو جوڑنے کی کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy tiêu đề nào trên nền tảng được kết nối của bạn cho bộ lọc này. Hãy thử kết nối nhiều nền tảng hơn trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您连接的平台上找不到此过滤器的标题。尝试在“设置”中连接更多平台。"
          }
        },
        "zh-Hant": {
