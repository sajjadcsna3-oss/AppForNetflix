        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se pot încărca achizițiile. Vă rugăm să încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно загрузить покупки. Пожалуйста, попробуйте еще раз."
          }
        },
