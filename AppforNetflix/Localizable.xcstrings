    "Enjoy uninterrupted browsing with zero ads.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمتع بالتصفح دون انقطاع وبدون إعلانات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শূন্য বিজ্ঞাপনের সাথে নিরবচ্ছিন্ন ব্রাউজিং উপভোগ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Užijte si nepřerušované procházení bez reklam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyd uafbrudt browsing uden annoncer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genießen Sie ununterbrochenes Surfen ohne Werbung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απολαύστε αδιάκοπη περιήγηση με μηδενικές διαφημίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoy uninterrupted browsing with zero ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfrute de una navegación ininterrumpida sin anuncios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauti keskeytymättömästä selaamisesta ilman mainoksia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-enjoy ang walang patid na pagba-browse na walang mga ad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez d'une navigation ininterrompue sans publicité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תהנה מגלישה ללא הפרעה עם אפס מודעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शून्य विज्ञापनों के साथ निर्बाध ब्राउज़िंग का आनंद लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživajte u neprekinutom pregledavanju bez oglasa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Élvezze a megszakítás nélküli böngészést hirdetések nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikmati penjelajahan tanpa gangguan tanpa iklan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Goditi la navigazione ininterrotta senza pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告なしで中断のないブラウジングをお楽しみください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고 없이 중단 없이 탐색을 즐겨보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikmati penyemakan imbas tanpa gangguan dengan sifar iklan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyt uavbrutt surfing uten annonser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geniet van ononderbroken browsen zonder advertenties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciesz się nieprzerwanym przeglądaniem bez reklam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfrute de uma navegação ininterrupta sem anúncios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucurați-vă de navigarea neîntreruptă fără reclame."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наслаждайтесь непрерывным просмотром страниц без рекламы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Užite si neprerušované prehliadanie bez reklám."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Njut av oavbruten surfning med noll annonser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลิดเพลินกับการท่องเว็บอย่างต่อเนื่องโดยไม่มีโฆษณา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfır reklamla kesintisiz gezinmenin keyfini çıkarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Насолоджуйтеся безперервним переглядом без реклами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صفر اشتہارات کے ساتھ بلاتعطل براؤزنگ کا لطف اٹھائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tận hưởng trải nghiệm duyệt web không bị gián đoạn và không có quảng cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "享受零广告不间断的浏览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "享受零廣告不間斷的瀏覽。"
          }
        }
      }
    },
    "Explore content from any region, anytime.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استكشف المحتوى من أي منطقة وفي أي وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোন অঞ্চল থেকে যে কোন সময় বিষয়বস্তু অন্বেষণ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozkoumejte obsah z jakéhokoli regionu a kdykoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udforsk indhold fra enhver region, når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecken Sie Inhalte aus jeder Region und jederzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξερευνήστε περιεχόμενο από οποιαδήποτε περιοχή, ανά πάσα στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore content from any region, anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore contenido de cualquier región, en cualquier momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutustu sisältöön miltä tahansa alueelta ja milloin tahansa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Galugarin ang nilalaman mula sa anumang rehiyon, anumang oras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorez le contenu de n’importe quelle région, à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חקור תוכן מכל אזור ובכל זמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी समय, किसी भी क्षेत्र की सामग्री का अन्वेषण करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Istražite sadržaj iz bilo koje regije, bilo kada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fedezze fel a tartalmat bármely régióból, bármikor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelajahi konten dari wilayah mana pun, kapan pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora contenuti da qualsiasi regione, in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも、あらゆる地域のコンテンツを探索できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제 어디서나 모든 지역의 콘텐츠를 탐색하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teroka kandungan dari mana-mana rantau, pada bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utforsk innhold fra hvilken som helst region, når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontdek inhoud uit elke regio, op elk moment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj treści z dowolnego regionu, w dowolnym momencie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore conteúdos de qualquer região, a qualquer hora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorați conținut din orice regiune, oricând."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исследуйте контент из любого региона в любое время."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Preskúmajte obsah z akéhokoľvek regiónu a kedykoľvek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utforska innehåll från vilken region som helst, när som helst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำรวจเนื้อหาจากภูมิภาคใดก็ได้ทุกเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğiniz zaman, istediğiniz bölgedeki içeriği keşfedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Досліджуйте вміст із будь-якого регіону та будь-коли."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی بھی علاقے سے، کسی بھی وقت مواد کو دریافت کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khám phá nội dung từ mọi khu vực, mọi lúc."
          }
        },
        "zh-Hans": {
