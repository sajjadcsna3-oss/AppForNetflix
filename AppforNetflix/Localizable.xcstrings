    "No account found. Please check your email or Sign Up.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على حساب. يرجى التحقق من بريدك الإلكتروني أو الاشتراك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অ্যাকাউন্ট পাওয়া যায়নি। আপনার ইমেল চেক করুন বা সাইন আপ করুন."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl nalezen žádný účet. Zkontrolujte prosím svůj e-mail nebo se zaregistrujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto fundet. Tjek venligst din e-mail eller tilmeld dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto gefunden. Bitte überprüfen Sie Ihre E-Mails oder melden Sie sich an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε λογαριασμός. Ελέγξτε το email σας ή Εγγραφείτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account found. Please check your email or Sign Up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna cuenta. Por favor revise su correo electrónico o regístrese."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiliä ei löytynyt. Tarkista sähköpostisi tai rekisteröidy."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nahanap na account. Mangyaring suriin ang iyong email o Mag-sign Up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte trouvé. Veuillez vérifier votre courrier électronique ou vous inscrire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצא חשבון. אנא בדוק את האימייל שלך או הירשם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई खाता नहीं मिला. कृपया अपना ईमेल जांचें या साइन अप करें।"
          }
        },
        "hr": {
