    "Check your new email address to confirm the change.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من عنوان بريدك الإلكتروني الجديد لتأكيد التغيير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিবর্তন নিশ্চিত করতে আপনার নতুন ইমেল ঠিকানা চেক করুন."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte svou novou e-mailovou adresu a potvrďte změnu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek din nye e-mailadresse for at bekræfte ændringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie Ihre neue E-Mail-Adresse, um die Änderung zu bestätigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε τη νέα σας διεύθυνση email για να επιβεβαιώσετε την αλλαγή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your new email address to confirm the change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique su nueva dirección de correo electrónico para confirmar el cambio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista uusi sähköpostiosoitteesi vahvistaaksesi muutoksen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingnan ang iyong bagong email address upang kumpirmahin ang pagbabago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre nouvelle adresse e-mail pour confirmer le changement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק את כתובת הדוא\"ל החדשה שלך כדי לאשר את השינוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवर्तन की पुष्टि के लिए अपना नया ईमेल पता जांचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite svoju novu adresu e-pošte kako biste potvrdili promjenu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizze új e-mail címét a módosítás megerősítéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa alamat email baru Anda untuk mengonfirmasi perubahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il tuo nuovo indirizzo email per confermare la modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい電子メール アドレスをチェックして、変更を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 확인하려면 새 이메일 주소를 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak alamat e-mel baharu anda untuk mengesahkan perubahan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk den nye e-postadressen din for å bekrefte endringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer uw nieuwe e-mailadres om de wijziging te bevestigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź swój nowy adres e-mail, aby potwierdzić zmianę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o seu novo endereço de e-mail para confirmar a alteração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați noua adresă de e-mail pentru a confirma modificarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте свой новый адрес электронной почты, чтобы подтвердить изменение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte svoju novú e-mailovú adresu a potvrďte zmenu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera din nya e-postadress för att bekräfta ändringen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบที่อยู่อีเมลใหม่ของคุณเพื่อยืนยันการเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişikliği onaylamak için yeni e-posta adresinizi kontrol edin."
