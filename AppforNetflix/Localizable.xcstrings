          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas falhadas. Por favor, tente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe încercări eșuate. Vă rugăm să încercați din nou mai târziu."
