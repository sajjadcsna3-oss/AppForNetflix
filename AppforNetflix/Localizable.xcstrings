        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind for at synkronisere din profil og premium-status"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich an, um Ihr Profil und Ihren Premium-Status zu synchronisieren"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
