        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour synchroniser votre profil et votre statut premium"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היכנס כדי לסנכרן את הפרופיל שלך ואת סטטוס הפרימיום שלך"
